# Copia este archivo como ".env" y pega tus credenciales de Supabase
# (Project Settings -> API en app.supabase.com).
# Mientras estos valores no estén configurados, la app funciona en modo
# demo con datos locales (localStorage) — ver README.md.

VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
